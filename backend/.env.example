# ===================================================
# Legal CaseBook - Environment Configuration Template
# Copy this file to .env before starting the server:
# Copy-Item .env.example .env
# ===================================================

# Flask Server Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
HOST=127.0.0.1

# ---------------------------------------------------
# Oracle Database Configuration (Stage 3)
# ---------------------------------------------------
# python-oracledb operates in Thin Mode by default (no Oracle Instant Client needed).
# Provide your Oracle database connection details below:

ORACLE_USER=legal_admin
ORACLE_PASSWORD=your_secure_password_here

# Option A: Standard Data Source Name (DSN) - Recommended
ORACLE_DSN=localhost:1521/XEPDB1

# Option B: Individual connection components (used if ORACLE_DSN is blank)
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=XEPDB1

# Optional Thick Mode: Only set if your environment requires Oracle Instant Client
# ORACLE_CLIENT_DIR=C:\oracle\instantclient_21_13

# Application Security
SECRET_KEY=legal-casebook-insecure-stage3-change-in-production

# ---------------------------------------------------
# xAI Grok API Configuration (Stage 6.2 - Model Preference & Callback Fallbacks)
# Obtain an API key from the official xAI Console: https://console.x.ai/
# Never expose this key in client-side code (React/Vite).
XAI_API_KEY=your_real_key_here
XAI_MODEL=grok-2-latest
XAI_FALLBACK_MODELS=grok-2,grok-beta,grok-2-mini,grok-vision-beta
XAI_TIMEOUT=60

